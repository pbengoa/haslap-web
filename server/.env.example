# Copia este archivo a .env para configurar el servidor.

API_PORT=4000
JWT_SECRET=cambia-esto-en-produccion

# ---------------------------------------------------------------------------
# Origen de datos
# ---------------------------------------------------------------------------
# Sin HASLAP_API_URL el servidor usa el seed en memoria (datos dummy).
# Con ella, hace de BFF contra el modulo haslapapp de PrestaShop.
#   PRE: https://haslap.okoiagency.com
HASLAP_API_URL=
HASLAP_API_TIMEOUT=20000

# ---------------------------------------------------------------------------
# Google (solo aplica al modo dummy: el backend real no admite login con Google)
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=

# ---------------------------------------------------------------------------
# Acceso por telefono (SMS via Firebase)
# ---------------------------------------------------------------------------
# El servidor solo necesita saber SI esta configurado, para decirle al front
# que ofrezca o no ese metodo. El SMS lo pide el navegador (ver web/.env).
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
