# Copia a web/.env para activar el acceso con teléfono.
#
# Los valores de Firebase web son PÚBLICOS por diseño (van en el bundle del
# navegador). La seguridad no está en ocultarlos, sino en la lista de dominios
# autorizados de Firebase Console → Authentication → Settings → Authorized
# domains, donde hay que dar de alta localhost y el dominio de la web.
#
# Sin estas variables el acceso por teléfono se muestra como no disponible.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
