# Copia a .env. Todas se leen al CONSTRUIR, no al arrancar: si cambias una,
# hay que volver a construir el front.

# ---------------------------------------------------------------------------
# Dónde vive la API
# ---------------------------------------------------------------------------
# Vacío = el mismo origen que la web. Es lo correcto en desarrollo, donde el
# proxy de Vite reenvía /api al Node local.
#
# Al desplegar el front por su cuenta hay que apuntarlo al dominio del servidor:
#   VITE_API_URL=https://api.haslap.com
#
# Sin API no hay datos: el navegador no puede hablar con PrestaShop directamente
# —la cookie de sesión es SameSite=Lax— ni entiende la forma en que responde.
VITE_API_URL=

# ---------------------------------------------------------------------------
# Acceso por teléfono (SMS vía Firebase)
# ---------------------------------------------------------------------------
# Estos valores son PÚBLICOS por diseño: van en el bundle del navegador. La
# seguridad no está en ocultarlos, sino en la lista de dominios autorizados de
# Firebase Console → Authentication → Settings → Authorized domains, donde hay
# que dar de alta el dominio de la web. `localhost` ya viene autorizado.
#
# Sin estas variables el acceso por teléfono se muestra como no disponible.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
