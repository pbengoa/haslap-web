# Copia a .env. Todas se leen al CONSTRUIR, no al arrancar: si cambias una,
# hay que volver a construir el front.

# ---------------------------------------------------------------------------
# Backend
# ---------------------------------------------------------------------------
# El modulo haslapapp de PrestaShop, con el que el navegador habla directo.
# Vacio = el entorno de PRE, que es lo que se usa en desarrollo.
#
#   PRE: https://haslap.okoiagency.com
VITE_API_URL=

# ---------------------------------------------------------------------------
# Acceso por telefono (SMS via Firebase)
# ---------------------------------------------------------------------------
# Estos valores son PUBLICOS por diseno: van en el bundle del navegador. La
# seguridad no esta en ocultarlos, sino en la lista de dominios autorizados de
# Firebase Console -> Authentication -> Settings -> Authorized domains, donde
# hay que dar de alta el dominio de la web. `localhost` ya viene autorizado.
#
# Sin estas variables el acceso por telefono se muestra como no disponible.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
